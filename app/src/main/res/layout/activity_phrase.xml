<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/phrase_activity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.PhraseActivity"
    >

    <ImageView
        android:id="@+id/image_cat"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:src="@drawable/cat_svgrepo_com"
        android:background="@color/blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/image_dog"
        app:tint="@color/black">
    </ImageView>

    <ImageView
        android:id="@+id/image_dog"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:src="@drawable/dog_airedale_terrier_svgrepo_com"
        android:background="@color/blue"
        app:tint="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/image_bird"
        app:layout_constraintStart_toEndOf="@id/image_cat"
        >
    </ImageView>

    <ImageView
        android:id="@+id/image_bird"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:src="@drawable/bird_svgrepo_com"
        android:background="@color/blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/image_dog"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/black">
    </ImageView>

    <TextView
        android:id="@+id/text_first_hello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_first_hello"
        android:textAlignment="center"
        android:layout_marginTop="40dp"
        app:layout_constraintHorizontal_chainStyle="packed"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/text_second_hello"
        app:layout_constraintTop_toBottomOf="@+id/image_cat">
    </TextView>

    <TextView
        android:id="@+id/text_second_hello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginTop="40dp"
        android:textSize="30sp"
        app:layout_constraintStart_toEndOf="@id/text_first_hello"
        app:layout_constraintTop_toBottomOf="@+id/image_cat"
        app:layout_constraintEnd_toEndOf="parent">
    </TextView>

    <TextView
        android:id="@+id/text_phrase"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="25sp"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:paddingHorizontal="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >
    </TextView>
    
    <Button
        android:id="@+id/button_generate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/light_blue"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:layout_marginBottom="20dp"
        android:text="@string/button_generate"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/button_edit_name">

    </Button>

    <Button
        android:id="@+id/button_edit_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:backgroundTint="@color/light_blue"
        android:textColor="@color/black"
        android:layout_marginBottom="20dp"
        android:text="@string/button_edit_name_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/button_generate"
        app:layout_constraintEnd_toEndOf="parent"
        >
    </Button>





</androidx.constraintlayout.widget.ConstraintLayout>